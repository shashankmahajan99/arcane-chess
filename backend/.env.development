# Development Environment Configuration for Arcane Chess

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost
GO_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arcane_chess_dev
DB_USER=postgres
DB_PASSWORD=password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration (64-character secret for development)
JWT_SECRET=arcane_chess_super_secret_development_key_that_is_very_long_and_secure

# WebSocket Configuration
WS_PORT=8080
WS_PATH=/ws

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8080/api/v1
REACT_APP_WS_URL=ws://localhost:8080/ws